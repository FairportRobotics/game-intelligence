# Copy this file to ".env" and fill in the values.
# The real ".env" is listed in .gitignore. NEVER commit it.

# The Blue Alliance API key (get one at https://www.thebluealliance.com/account)
TBA_API_KEY=put-your-key-here

# FIRST FRC Events API (optional, only needed if we add it as a second live source)
FIRST_API_USERNAME=
FIRST_API_TOKEN=

# The event we are working on, in TBA format: <year><code>, for example 2026nyro
EVENT_KEY=2026nyro

# Our team number
OUR_TEAM=578

# Shared passcode for the web app (keep it simple; this is not Fort Knox)
EVENT_PASSCODE=change-me

# Flask secret key (any long random string)
SECRET_KEY=change-me-too